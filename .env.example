# Use mock data from IndexedDB/localStorage (true by default).
# Set to false to use the real API.
VITE_USE_MOCK=true

# API base URL (optional, defaults to /api)
# Uncomment and change if your backend is on a different URL
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_API_BASE_URL=https://api.remontti.com