{
  "openapi": "3.0.3",
  "info": {
    "title": "CRM System API",
    "description": "API для системы управления CRM Ремонтти",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@remontti.com"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "API server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Операции аутентификации"
    },
    {
      "name": "Translations",
      "description": "Операции с переводами"
    },
    {
      "name": "Branches",
      "description": "Операции с филиалами"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Войти в систему",
        "description": "Аутентификация пользователя по логину и паролю",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешная аутентификация",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Неверный логин или пароль",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Ошибка валидации",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Выйти из системы",
        "description": "Завершение сессии пользователя",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный выход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          }
        }
      }
    },
    "/company/branches/get": {
      "get": {
        "tags": ["Branches"],
        "summary": "Получить список филиалов",
        "description": "Возвращает список доступных пользователю филиалов",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Успешное получение списка филиалов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBranchesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Неавторизованный запрос",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["login", "password"],
        "properties": {
          "login": {
            "type": "string",
            "description": "Логин пользователя (формат: строка.строка)",
            "example": "t.test"
          },
          "password": {
            "type": "string",
            "description": "Пароль пользователя",
            "example": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "description": "JWT токен для авторизации",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "error": {
            "type": "string",
            "example": "Invalid login or password"
          }
        }
      },
      "LogoutResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["login", "email", "name", "role"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "login": {
            "type": "string",
            "example": "t.test"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "t.test@company.com"
          },
          "name": {
            "type": "string",
            "example": "Test User"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "user", "manager", "employee"],
            "example": "admin"
          },
          "startPage": {
            "type": "string",
            "description": "Стартовая страница пользователя после входа",
            "example": "/dashboard"
          }
        }
      },
      "TranslationResponse": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "example": {
          "login.title": "CRM System",
          "login.subtitle": "Enter your credentials",
          "login.sign_in": "Sign In"
        }
      },
      "GetBranchesResponse": {
        "type": "object",
        "required": ["success", "branches"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "branches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Branch"
            }
          }
        }
      },
      "Branch": {
        "type": "object",
        "required": ["id", "name", "code", "isActive"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Название филиала",
            "example": "Плаза"
          },
          "code": {
            "type": "string",
            "description": "Код филиала",
            "example": "plaza"
          },
          "address": {
            "type": "string",
            "description": "Адрес филиала",
            "example": "ТЦ Плаза, ул. Примерная 1"
          },
          "isActive": {
            "type": "boolean",
            "description": "Активен ли филиал",
            "example": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["status", "message"],
        "properties": {
          "status": {
            "type": "integer",
            "example": 401
          },
          "message": {
            "type": "string",
            "example": "Invalid login or password"
          },
          "code": {
            "type": "string",
            "example": "AUTH_FAILED"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": ["status", "errors"],
        "properties": {
          "status": {
            "type": "integer",
            "example": 422
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "login"
                },
                "message": {
                  "type": "string",
                  "example": "Field is required"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
